#include <Wire.h>
#include <VL53L1X.h>
#include "pio_encoder.h"

// Encoder setup on GPIO 14 & 15
PioEncoder encoder(14); 

const uint8_t sensorCount = 2;
VL53L1X sensors[sensorCount];

// Store latest valid readings
static uint16_t last_tof0 = 0;
static uint16_t last_tof1 = 0;

// Readiness flags
bool tof0_data_ready = false;
bool tof1_data_ready = false;
int encoder_count = 0;

void setup()
{
  encoder.begin();
  
  Serial.begin(115200);
  unsigned long start = millis();
  while (!Serial && (millis() - start < 2000)) {} 

  // Initialize Hardware UART2 (Serial2)
  Serial2.setTX(8);
  Serial2.setRX(9);
  Serial2.begin(115200);
  delay(2000); 
  Serial.println("RP2040 UART Initialized.");

  // --- Bus 0 Configuration (GPIO 4 & 5) ---
  Wire.setSDA(4);
  Wire.setSCL(5);
  Wire.begin();
  Wire.setClock(400000);

  // --- Bus 1 Configuration (GPIO 6 & 7) ---
  Wire1.setSDA(6);
  Wire1.setSCL(7);
  Wire1.begin();
  Wire1.setClock(400000);

  // Initialize Sensor 0 on Wire (Bus 0)
  sensors[0].setTimeout(500);
  sensors[0].setBus(&Wire); // Assign to First Bus
  if (!sensors[0].init()) {
    Serial.println("Failed to detect sensor 0 on Wire (GPIO 4/5)");
    while (1);
  }
  sensors[0].setDistanceMode(VL53L1X::Long);
  sensors[0].setMeasurementTimingBudget(50000);
  sensors[0].startContinuous(50);

  // Initialize Sensor 1 on Wire1 (Bus 1)
  sensors[1].setTimeout(500);
  sensors[1].setBus(&Wire1); // Assign to Second Bus
  if (!sensors[1].init()) {
    Serial.println("Failed to detect sensor 1 on Wire1 (GPIO 6/7)");
    while (1);
  }
  sensors[1].setDistanceMode(VL53L1X::Long);
  sensors[1].setMeasurementTimingBudget(50000);
  sensors[1].startContinuous(50);
}

void loop()
{
  encoder_count = encoder.getCount();

  // Continuously update ToF sensor values
  for (uint8_t i = 0; i < sensorCount; i++) {
    if (sensors[i].dataReady()) {
      sensors[i].read();
      if (i == 0) { 
        last_tof0 = sensors[i].ranging_data.range_mm;
        tof0_data_ready = true;
      }
      if (i == 1) { 
        last_tof1 = sensors[i].ranging_data.range_mm;
        tof1_data_ready = true;
      }
    }
  }

  // Print data once both sensors have a fresh measurement
  if (tof0_data_ready && tof1_data_ready) {
    // Serial2 Output
    Serial2.print("encoder count: ");
    Serial2.print(encoder_count);
    Serial2.print(", tof0: ");
    Serial2.print(last_tof0);
    Serial2.print(", tof1: ");
    Serial2.println(last_tof1);

    // USB Serial Output
    Serial.print(encoder_count);
    Serial.print(",");
    Serial.print(last_tof0);
    Serial.print(",");
    Serial.println(last_tof1);

    // Reset flags
    tof0_data_ready = false;
    tof1_data_ready = false;

  }
}
